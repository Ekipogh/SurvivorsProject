.shop-screen {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    background-color: rgba(4, 7, 10, 0.64);
}

.shop-panel {
    width: 620px;
    max-width: 88%;
    padding-top: 28px;
    padding-right: 30px;
    padding-bottom: 30px;
    padding-left: 30px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(219, 229, 219, 0.48);
    border-right-color: rgba(72, 103, 103, 0.86);
    border-bottom-color: rgba(37, 52, 56, 0.96);
    border-left-color: rgba(219, 229, 219, 0.48);
    background-color: rgba(17, 22, 24, 0.96);
}

.shop-title {
    margin-bottom: 6px;
    color: rgb(247, 241, 219);
    font-size: 30px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.shop-subtitle {
    margin-bottom: 22px;
    color: rgb(177, 193, 190);
    font-size: 14px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.shop-options {
    flex-direction: row;
    justify-content: center;
}

.shop-option {
    width: 164px;
    height: 176px;
    margin-top: 0;
    margin-right: 8px;
    margin-bottom: 0;
    margin-left: 8px;
    padding-top: 14px;
    padding-right: 12px;
    padding-bottom: 12px;
    padding-left: 12px;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgba(238, 226, 175, 0.62);
    border-right-color: rgba(128, 119, 74, 0.88);
    border-bottom-color: rgba(67, 65, 48, 0.95);
    border-left-color: rgba(238, 226, 175, 0.62);
    background-color: rgb(34, 45, 47);
    color: rgb(249, 241, 213);
    font-size: 16px;
    -unity-font-style: bold;
}

.shop-option-image {
    width: 112px;
    height: 112px;
    margin-bottom: 10px;
    -unity-background-scale-mode: scale-to-fit;
    picking-mode: ignore;
}

.shop-option-image-a {
    background-image: url("project://database/Assets/Sprites/Weapons/SimpleGun.png?fileID=49891880447364413&guid=fbb45aae106ef23478d8d4babb9a7872&type=3#SimpleGun_0");
}

.shop-option-image-b {
    background-image: url("project://database/Assets/Sprites/Weapons/rocket.png?fileID=-9158349384845336690&guid=8910e114366a4c2448a757d67a93f65f&type=3#rocket_0");
}

.shop-option-image-c {
    background-image: url("project://database/Assets/Sprites/Weapons/lazer_gun.png?fileID=3549103124396321121&guid=da2f74f2d475415449144ae7b12b0f57&type=3#lazer_gun_0");
}

.shop-option-label {
    color: rgb(249, 241, 213);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    picking-mode: ignore;
}

.shop-option:hover {
    background-color: rgb(45, 63, 64);
    color: rgb(255, 249, 225);
}

.shop-option:active {
    background-color: rgb(28, 37, 38);
}
